{
  "manifest_version": 3,
  "name": "Bookmark Bridge",
  "version": "1.0.0",
  "description": "Choose, arrange, and transfer bookmarks with a duplicate-aware import preview.",
  "minimum_chrome_version": "109",
  "permissions": ["bookmarks", "storage"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Bookmark Bridge", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
